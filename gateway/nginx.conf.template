server {
  # Render (and most PaaS hosts) inject their own PORT and expect the app
  # to bind to it - without this, nginx keeps listening on 8080 while the
  # platform's port scanner looks for whatever PORT it assigned, and the
  # deploy times out as "no open ports detected" (the exact failure the
  # 4 backend services hit before their own server.port became
  # ${PORT:...}-driven). Falls back to 8080 for docker-compose, which
  # never sets PORT.
  listen ${PORT};
  root /usr/share/nginx/html;
  index index.html;
  # Compose services can come up after Nginx. Resolve them at request time
  # instead of failing the whole gateway during its initial config parse.
  # Also what makes this config portable beyond docker-compose: the four
  # upstream URLs come from env vars (envsubst'd into this file by nginx's
  # own docker-entrypoint.d/20-envsubst-on-templates.sh at container start -
  # see the Dockerfile's ENV defaults and NGINX_ENVSUBST_FILTER), not
  # hardcoded compose service names. Point them at each service's public
  # URL on a host like Render and nothing else here needs to change.
  # Docker's embedded DNS (127.0.0.11) only exists inside a Docker network -
  # it won't exist at all on a host like Render, so this is also env-driven
  # (set RESOLVER to a public resolver such as 8.8.8.8 there).
  resolver ${RESOLVER} valid=10s;
  set $tenant_catalog ${TENANT_CATALOG_URL};
  set $orders ${ORDERS_URL};
  set $credit ${CREDIT_URL};
  set $invoices ${INVOICES_URL};
  proxy_ssl_server_name on; # required for SNI when an upstream URL is https (e.g. Render); a no-op for plain http
  # nginx's default proxy timeouts (60s) are shorter than a free-tier
  # Render backend's cold-start time after spinning down from inactivity -
  # measured 48-79s for a genuinely healthy service that was just asleep.
  # Without this, the very first request after idle time 502s even though
  # everything is configured correctly, because nginx gives up waiting
  # before the backend finishes waking up.
  proxy_connect_timeout 120s;
  proxy_send_timeout 120s;
  proxy_read_timeout 120s;

  location = /api/tenants { rewrite ^/api/(.*)$ /$1 break; proxy_pass $tenant_catalog; }
  location /api/tenants/ { rewrite ^/api/(.*)$ /$1 break; proxy_pass $tenant_catalog; }
  location /api/catalog/ { rewrite ^/api/(.*)$ /$1 break; proxy_pass $tenant_catalog; }
  location /api/auth/ { rewrite ^/api/(.*)$ /$1 break; proxy_pass $tenant_catalog; }
  location = /api/documents { rewrite ^/api/(.*)$ /$1 break; proxy_pass $tenant_catalog; }
  location /api/orders/ { rewrite ^/api/(.*)$ /$1 break; proxy_pass $orders; }
  location = /api/orders { rewrite ^/api/(.*)$ /$1 break; proxy_pass $orders; }
  location /api/credit/ { rewrite ^/api/(.*)$ /$1 break; proxy_pass $credit; }
  location /api/admin/onboarding { rewrite ^/api/(.*)$ /$1 break; proxy_pass $tenant_catalog; }
  location /api/admin/ { rewrite ^/api/(.*)$ /$1 break; proxy_pass $credit; }
  location /api/invoices/ { rewrite ^/api/(.*)$ /$1 break; proxy_pass $invoices; }
  location = /api/invoices { rewrite ^/api/(.*)$ /$1 break; proxy_pass $invoices; }

  # Hashed build assets (index-XXXX.js/css) are safe to cache forever since
  # a new build always gets a new filename. index.html itself is NOT hashed
  # - without no-cache here, a browser can keep serving an old index.html
  # (and whatever old hashed JS it references) well after a new version has
  # been deployed, which is exactly what made an already-fixed frontend bug
  # look unfixed in the browser.
  location /assets/ { add_header Cache-Control "public, max-age=31536000, immutable"; try_files $uri =404; }
  location / { add_header Cache-Control "no-cache"; try_files $uri $uri/ /index.html; }
}
